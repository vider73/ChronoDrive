#!/usr/bin/env python3
"""ChronoDrive for Linux: the entry point (chronodrive --help). Python 3.8+, standard library only."""
import os
import sys

if sys.version_info < (3, 8):
    sys.exit("ChronoDrive needs Python 3.8 or newer")
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from cdrive.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
