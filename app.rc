#include <windows.h>
#include "version.h"
1 ICON "ChronoDrive.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION CD_VERSION_RC
PRODUCTVERSION CD_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ChronoScan"
      VALUE "FileDescription", "ChronoDrive"
      VALUE "FileVersion", CD_VERSION_STR
      VALUE "ProductName", "ChronoDrive"
      VALUE "ProductVersion", CD_VERSION_STR
      VALUE "LegalCopyright", "ChronoScan Capture SL"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
